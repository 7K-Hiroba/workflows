name: chart repair
on:
  workflow_dispatch:
    inputs:
      chart: {required: true, type: string}
      version: {required: true, type: string}
permissions: {contents: read}
jobs:
  repair:
    uses: 7K-Hiroba/workflows/.github/workflows/release-chart.yml@__WORKFLOWS_V1_SHA__ # v1.0.0
    with: {root: ., chart: "${{ inputs.chart }}", version: "${{ inputs.version }}", repair: true, standalone: true}
    permissions: {contents: read, packages: write, id-token: write, attestations: write, actions: read}
