name: chart repair
on:
  workflow_dispatch:
    inputs:
      chart: {required: true, type: string}
      version: {required: true, type: string}
permissions: {contents: read}
jobs:
  resolve:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs: {source-sha: "${{ steps.source.outputs.sha }}"}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: {path: consumer, fetch-depth: 0}
      - id: source
        env: {CHART: "${{ inputs.chart }}", VERSION: "${{ inputs.version }}"}
        run: |
          set -euo pipefail
          [[ "$CHART" =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 2
          [[ "$VERSION" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$ ]] || exit 2
          TAG="$CHART-v$VERSION"
          sha=$(git -C consumer ls-remote origin "refs/tags/$TAG^{}" | awk 'NR == 1 {print $1}')
          [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "repair requires an existing annotated tag $TAG" >&2; exit 2; }
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
  repair:
    needs: resolve
    uses: 7K-Hiroba/workflows/.github/workflows/release-chart.yml@__WORKFLOWS_V1_SHA__ # v1.0.0
    with:
      root: .
      chart: "${{ inputs.chart }}"
      version: "${{ inputs.version }}"
      source-sha: "${{ needs.resolve.outputs.source-sha }}"
      repair: true
      standalone: true
    permissions: {contents: read, packages: write, id-token: write, attestations: write, actions: read}
