name: compatibility nightly
on:
  schedule: [{cron: "17 4 * * *"}]
  workflow_dispatch: {}
permissions: {contents: read}
jobs:
  compat:
    uses: 7K-Hiroba/workflows/.github/workflows/compat-check.yml@__WORKFLOWS_V1_SHA__ # v1.0.0
    with: {root: ., mode: nightly}
    permissions: {contents: read, actions: read}
  notify:
    if: needs.compat.outputs.status == 'failure'
    needs: [compat]
    runs-on: ubuntu-latest
    permissions: {contents: read, issues: write}
    steps:
      - name: Open or update one early-warning issue
        env:
          GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}"
          RUN_URL: "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
        run: |
          number=$(gh issue list --state open --json number,title --jq '.[] | select(.title == "[compat] edge incompatibility") | .number' | head -n 1)
          if [[ -n "$number" ]]; then gh issue comment "$number" --body "Edge compatibility failed again: $RUN_URL"; else gh issue create --title '[compat] edge incompatibility' --body "Edge compatibility failed: $RUN_URL"; fi
