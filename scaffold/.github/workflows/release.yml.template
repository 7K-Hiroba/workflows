name: release
on:
  push: {branches: [main]}
  workflow_dispatch:
    inputs: {repair_tag: {required: false, type: string}}
permissions: {contents: read}
jobs:
  release:
    uses: 7K-Hiroba/workflows/.github/workflows/release.yml@__WORKFLOWS_V1_SHA__ # v1.0.0
    with: {root: ., repair_tag: "${{ inputs.repair_tag }}", app-id: "${{ vars.HIROBA_RELEASE_APP_ID }}"}
    secrets:
      release-private-key: "${{ secrets.HIROBA_RELEASE_PRIVATE_KEY }}"
    permissions: {contents: write, packages: write, id-token: write, attestations: write, actions: read}
