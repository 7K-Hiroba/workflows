{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-v",
  "pull-request-title-pattern": "chore: release ${component} ${version}",
  "packages": {
    "packages/admission-example": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "package.yaml"
      ],
      "component": "admission-example",
      "include-v-in-tag": false
    },
    "packages/app": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "package.yaml"
      ],
      "component": "app",
      "include-v-in-tag": false
    },
    "extension": {
      "release-type": "go",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "/extension.yaml"
        },
        "extension.go",
        {
          "type": "yaml",
          "path": "/.hiroba.yaml",
          "jsonpath": "$.components.extension.version"
        }
      ],
      "component": "extension",
      "include-v-in-tag": false
    },
    "packages/observability-pack": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "package.yaml"
      ],
      "component": "observability-pack",
      "include-v-in-tag": false
    },
    "templates/service": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "template.yaml"
      ],
      "component": "service",
      "include-v-in-tag": false
    },
    "ui": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "src/index.tsx",
        {
          "type": "yaml",
          "path": "/.hiroba.yaml",
          "jsonpath": "$.components.ui.version"
        }
      ],
      "component": "ui",
      "include-v-in-tag": false
    },
    "charts/workflows-scaffold": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "Chart.yaml"
      ],
      "component": "workflows-scaffold",
      "include-v-in-tag": false
    }
  }
}
