{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/chart-test-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": {"const": "inari.chart-test.v1"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "repository", "tag"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"const": "latest"}}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout"],
      "properties": {"timeout": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}}
    }
  }
}
