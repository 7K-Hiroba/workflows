{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/lane-result-v1.json",
  "type": "object",
  "required": ["schema", "lane", "status", "sourceSha"],
  "properties": {
    "schema": {"const": "inari.lane-result.v1"},
    "lane": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "skipped"]},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "targetAdapter": {"enum": ["helm", "manifests"]},
    "targetComponent": {"type": "string"},
    "targetVersion": {"type": "string"},
    "targetDigest": {"type": "string"},
    "fixtureOnly": {"type": "boolean"},
    "executableProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ci", "stage", "prod"]}
    },
    "evidenceScope": {"enum": ["application", "fixture"]},
    "appEvidenceEligible": {"type": "boolean"}
  }
}
