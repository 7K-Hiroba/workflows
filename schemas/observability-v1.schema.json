{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/observability-v1.json",
  "type": "object",
  "required": ["apiVersion", "kind", "app", "folder", "datasources", "dashboards", "rules", "targets", "severityRouting", "minimumAppVersion", "observabilityPack"],
  "properties": {
    "kind": {"const": "Observability"},
    "app": {"type": "string"},
    "folder": {"type": "string"},
    "datasources": {"type": "object", "minProperties": 1},
    "linkVariables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dashboards": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "uid", "file"], "properties": {"title": {"type": "string"}, "uid": {"type": "string"}, "file": {"type": "string"}}}},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["file", "evaluation"], "properties": {"file": {"type": "string"}, "evaluation": {"enum": ["local", "central"]}}}},
    "targets": {"type": "array", "minItems": 1, "items": {"enum": ["central", "local"]}, "uniqueItems": true},
    "severityRouting": {"type": "object", "minProperties": 1},
    "minimumAppVersion": {"type": "string", "minLength": 1},
    "observabilityPack": {"type": "object", "required": ["package", "versionRange"], "properties": {"package": {"type": "string"}, "versionRange": {"type": "string", "not": {"const": "latest"}}}}
  }
}
