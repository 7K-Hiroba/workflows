{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/package-v1.json",
  "type": "object",
  "required": ["version", "channel", "type", "description", "category"],
  "properties": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "channel": {"enum": ["stable", "incubating"]},
    "type": {"enum": ["kro-rgd", "platform-app", "policy-pack"]},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "observability": {
      "type": "object",
      "required": ["package", "versionRange"],
      "properties": {"package": {"type": "string"}, "versionRange": {"type": "string", "not": {"const": "latest"}}}
    }
  }
}
