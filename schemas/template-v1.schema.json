{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/template-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "channel", "description", "kind"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "channel": {"enum": ["stable", "incubating"]},
    "description": {"type": "string", "minLength": 1},
    "kind": {"enum": ["component", "gitops-repo"]}
  }
}
