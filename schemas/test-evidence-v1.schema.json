{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/hiroba/test-evidence-v1.json",
  "type": "object",
  "required": ["schema", "app", "component", "trustTier", "sourceRepository", "sourceSha", "releaseTag", "artifact", "producer", "lanes", "evidenceDigest", "finishedAt"],
  "properties": {
    "schema": {"const": "inari.test-evidence.v1"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {"type": "object", "required": ["repository", "digest", "mediaType"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "producer": {"type": "object", "required": ["workflowRepository", "workflowPath", "workflowSha", "runId", "runAttempt"]},
    "lanes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["lane", "status", "required"]}},
    "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
